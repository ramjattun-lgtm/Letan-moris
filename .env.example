# Letan Moris — environment variables (copy to .env.local for local development).
# No variable is required for Phase 1: Open-Meteo's free API needs no key.

# Which weather provider to use (only "open-meteo" exists today).
WEATHER_PRIMARY_PROVIDER=open-meteo

# Safety switch: paid providers stay disabled unless this is "true" AND the owner has authorised them.
ALLOW_PAID_PROVIDERS=false

# --- Phase 1B/1C (not used yet) — set these in Vercel / GitHub secrets, never in code ---
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_APP_SECRET=
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# OWNER_DASHBOARD_PASSWORD=
